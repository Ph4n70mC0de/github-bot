{
  "name": "github-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "deploy": "docker build -t github-bot . && docker run -p 3000:3000 --env-file .env github-bot",
    "docker:build": "docker build -t github-bot .",
    "docker:run": "docker run -p 3000:3000 --env-file .env github-bot"
  },
  "dependencies": {
    "@octokit/app": "^16.1.2",
    "@octokit/rest": "^22.0.1",
    "@sentry/node": "^10.68.0",
    "bullmq": "^5.81.2",
    "dotenv": "^16.4.5",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "pino": "^9.4.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
